{
  "name": "fertig-app",
  "version": "1.0.2",
  "private": true,
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.fertig.app",
    "productName": "Fertig App",
    "artifactName": "Fertig-App-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "a-kowalenko",
        "repo": "fertig-app",
        "releaseType": "draft"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*"
    ],
    "mac": {
      "target": "dmg",
      "icon": "assets/macos/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/windows/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/linux/icons"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.27",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "electron-store": "^11.0.2",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.0.0",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.2",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.1",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.14.0"
  }
}
